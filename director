<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ДИРЕКТОР — вайбкодер</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: #000;
    color: #fff;
    font-family: 'Courier New', monospace;
    overflow-x: hidden;
    cursor: none;
  }

  /* ===== КАСТОМНЫЙ КУРСОР ===== */
  .cursor {
    position: fixed;
    width: 12px; height: 12px;
    background: #fff;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: difference;
  }
  .cursor.big { width: 40px; height: 40px; background: #fff; }

  /* ===== ПРОГРЕСС-БАР ===== */
  .progress {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    background: #fff;
    width: 0%;
    z-index: 9998;
    box-shadow: 0 0 10px #fff;
  }

  /* ===== МАТРИЧНЫЙ ФОН ===== */
  #matrix {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    opacity: 0.3;
  }

  .content { position: relative; z-index: 1; }

  /* ===== МЕНЮ ===== */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  nav .logo {
    font-weight: 700;
    letter-spacing: 0.2em;
    font-size: 1rem;
  }

  nav ul {
    display: flex;
    gap: 30px;
    list-style: none;
  }

  nav a {
    color: #bbb;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    transition: color 0.3s;
    position: relative;
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: -5px; left: 0;
    width: 0; height: 1px;
    background: #fff;
    transition: width 0.3s;
  }

  nav a:hover { color: #fff; }
  nav a:hover::after { width: 100%; }

  /* Бургер для мобилки */
  .burger { display: none; cursor: none; }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 120px 20px 40px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 12vw, 8rem);
    letter-spacing: 0.15em;
    font-weight: 700;
    text-shadow: 0 0 30px rgba(255,255,255,0.5);
    position: relative;
  }

  .hero h1:hover {
    animation: glitch 0.3s infinite;
  }

  @keyframes glitch {
    0% { transform: translate(0); text-shadow: 0 0 30px rgba(255,255,255,0.5); }
    20% { transform: translate(-3px, 2px); text-shadow: 3px 0 #fff, -3px 0 #666; }
    40% { transform: translate(3px, -2px); text-shadow: -3px 0 #fff, 3px 0 #666; }
    60% { transform: translate(-2px, -2px); }
    80% { transform: translate(2px, 2px); }
    100% { transform: translate(0); }
  }

  .hero .typed {
    margin-top: 25px;
    font-size: clamp(0.9rem, 2.5vw, 1.3rem);
    color: #bbb;
    min-height: 1.5em;
  }

  .hero .typed::after {
    content: '_';
    animation: blink 1s step-end infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .hero-buttons {
    margin-top: 45px;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    padding: 14px 32px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    font-family: inherit;
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    cursor: none;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .btn:hover {
    background: #fff;
    color: #000;
    box-shadow: 0 0 30px rgba(255,255,255,0.6);
  }

  .scroll-hint {
    position: absolute;
    bottom: 30px;
    font-size: 0.75rem;
    color: #666;
    letter-spacing: 0.3em;
    animation: float 2s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(10px); }
  }

  /* ===== СЕКЦИИ ===== */
  section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 100px 25px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s ease, transform 1s ease;
  }

  section.visible { opacity: 1; transform: translateY(0); }

  h2 {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    margin-bottom: 40px;
    letter-spacing: 0.1em;
    border-left: 3px solid #fff;
    padding-left: 15px;
  }

  h2::before { content: '> '; color: #888; }

  p, li {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #ccc;
  }

  /* ===== ФАКТЫ ===== */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .fact {
    border: 1px solid #333;
    padding: 25px 20px;
    text-align: center;
    transition: all 0.3s;
  }

  .fact:hover {
    border-color: #fff;
    transform: translateY(-5px);
  }

  .fact .num {
    font-size: 2.2rem;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }

  .fact .label {
    font-size: 0.8rem;
    color: #888;
    letter-spacing: 0.1em;
  }

  /* ===== НАВЫКИ ===== */
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
  }

  .skills li {
    border: 1px solid #444;
    padding: 10px 18px;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    cursor: none;
  }

  .skills li:hover {
    background: #fff;
    color: #000;
    transform: translateY(-3px);
    box-shadow: 0 0 25px rgba(255,255,255,0.4);
  }

  /* ===== ПРОЕКТЫ ===== */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .project {
    border: 1px solid #333;
    padding: 30px 25px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    cursor: none;
  }

  .project::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    transition: left 0.6s ease;
  }

  .project:hover::before { left: 100%; }

  .project:hover {
    border-color: #fff;
    transform: translateY(-5px);
    box-shadow: 0 10px 40px rgba(255,255,255,0.1);
  }

  .project .tag {
    font-size: 0.7rem;
    color: #888;
    letter-spacing: 0.2em;
    margin-bottom: 15px;
    display: block;
  }

  .project h3 {
    font-size: 1.3rem;
    margin-bottom: 12px;
    letter-spacing: 0.05em;
  }

  .project p {
    font-size: 0.9rem;
    color: #888;
  }

  .project .open {
    margin-top: 20px;
    font-size: 0.75rem;
    color: #fff;
    letter-spacing: 0.15em;
    display: inline-block;
    border-bottom: 1px solid #444;
    padding-bottom: 2px;
  }

  /* ===== МОДАЛКА ===== */
  .modal-bg {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(5px);
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    cursor: none;
  }

  .modal-bg.active { display: flex; }

  .modal {
    background: #0a0a0a;
    border: 1px solid #333;
    max-width: 600px;
    width: 100%;
    padding: 45px 35px;
    position: relative;
    animation: modalIn 0.4s ease;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.9) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .modal h3 {
    font-size: 1.8rem;
    margin-bottom: 20px;
    letter-spacing: 0.05em;
  }

  .modal p { margin-bottom: 15px; }

  .modal .close {
    position: absolute;
    top: 15px; right: 20px;
    font-size: 1.5rem;
    color: #888;
    background: none;
    border: none;
    cursor: none;
    font-family: inherit;
    transition: color 0.3s;
  }

  .modal .close:hover { color: #fff; }

  /* ===== КОНТАКТЫ ===== */
  .contacts { list-style: none; }

  .contacts li { margin-bottom: 15px; }

  .contacts a {
    color: #fff;
    text-decoration: none;
    font-size: 1.1rem;
    border-bottom: 1px solid #444;
    padding-bottom: 3px;
    transition: all 0.3s ease;
  }

  .contacts a:hover {
    border-color: #fff;
    text-shadow: 0 0 15px rgba(255,255,255,0.7);
  }

  footer {
    text-align: center;
    padding: 40px 20px;
    color: #555;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #000; }
  ::-webkit-scrollbar-thumb { background: #333; }
  ::-webkit-scrollbar-thumb:hover { background: #666; }

  /* ===== МОБИЛКА ===== */
  @media (max-width: 700px) {
    body { cursor: auto; }
    .cursor { display: none; }
    nav { padding: 15px 20px; }
    nav ul {
      position: fixed;
      top: 0; right: -100%;
      width: 70%; height: 100vh;
      background: #000;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 40px;
      transition: right 0.4s ease;
      border-left: 1px solid #222;
    }
    nav ul.open { right: 0; }
    nav ul a { font-size: 1.2rem; }
    .burger {
      display: block;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 101;
      font-family: inherit;
    }
    .btn { cursor: pointer; }
    .project, .skills li, .modal .close { cursor: pointer; }
  }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="progress" id="progress"></div>
<canvas id="matrix"></canvas>

<div class="content">

  <!-- МЕНЮ -->
  <nav>
    <div class="logo">ДИРЕКТОР</div>
    <ul id="navMenu">
      <li><a href="#about">Обо мне</a></li>
      <li><a href="#skills">Навыки</a></li>
      <li><a href="#projects">Проекты</a></li>
      <li><a href="#contacts">Контакты</a></li>
    </ul>
    <button class="burger" id="burger">☰</button>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <h1>ДИРЕКТОР</h1>
    <div class="typed" id="typed"></div>
    <div class="hero-buttons">
      <a href="#projects" class="btn">Смотреть проекты</a>
      <a href="#contacts" class="btn">Связаться</a>
    </div>
    <div class="scroll-hint">▼ СКРОЛЛ ▼</div>
  </div>

  <!-- ОБО МНЕ -->
  <section id="about">
    <h2>ОБО МНЕ</h2>
    <p>Вайбкодер. Делаю сайты, которые живут и дышат. Люблю анимацию, чистый код и хороший вайб. В свободное время — Dota 2.</p>
    <p style="margin-top:20px;">Мой подход: не шаблоны, а ощущение. Код должен не просто работать — он должен звучать.</p>

    <div class="facts">
      <div class="fact"><span class="num">∞</span><span class="label">ИДЕЙ</span></div>
      <div class="fact"><span class="num">24/7</span><span class="label">НА ВАЙБЕ</span></div>
      <div class="fact"><span class="num">7к</span><span class="label">MMR В DOTA</span></div>
      <div class="fact"><span class="num">100%</span><span class="label">РУЧНОЙ КОД</span></div>
    </div>
  </section>

  <!-- НАВЫКИ -->
  <section id="skills">
    <h2>НАВЫКИ</h2>
    <ul class="skills">
      <li>Вайбкодинг</li>
      <li>HTML / CSS</li>
      <li>JavaScript</li>
      <li>Анимации</li>
      <li>Веб-дизайн</li>
      <li>Работа с ИИ</li>
      <li>Dota 2</li>
    </ul>
  </section>

  <!-- ПРОЕКТЫ -->
  <section id="projects">
    <h2>ПРОЕКТЫ</h2>
    <div class="projects">
      <div class="project" onclick="openModal('p1')">
        <span class="tag">// 001</span>
        <h3>Матричное портфолио</h3>
        <p>Сайт, который ты сейчас смотришь. Чёрно-белый, с анимацией.</p>
        <span class="open">ПОДРОБНЕЕ →</span>
      </div>
      <div class="project" onclick="openModal('p2')">
        <span class="tag">// 002</span>
        <h3>Проект #2</h3>
        <p>Скоро здесь появится описание. Пока в разработке.</p>
        <span class="open">ПОДРОБНЕЕ →</span>
      </div>
      <div class="project" onclick="openModal('p3')">
        <span class="tag">// 003</span>
        <h3>Проект #3</h3>
        <p>Скоро здесь появится описание. Пока в разработке.</p>
        <span class="open">ПОДРОБНЕЕ →</span>
      </div>
    </div>
  </section>

  <!-- КОНТАКТЫ -->
  <section id="contacts">
    <h2>КОНТАКТЫ</h2>
    <ul class="contacts">
      <li>Telegram: <a href="#">@твой_ник</a></li>
      <li>GitHub: <a href="#">github.com/твой_ник</a></li>
      <li>Email: <a href="#">твоя@почта.com</a></li>
    </ul>
  </section>

  <footer>© 2026 ДИРЕКТОР — сделано на вайбе</footer>

</div>

<!-- МОДАЛКА -->
<div class="modal-bg" id="modalBg" onclick="closeModal(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <button class="close" onclick="closeModal()">✕</button>
    <h3 id="modalTitle"></h3>
    <p id="modalText"></p>
    <p id="modalText2"></p>
  </div>
</div>

<script>
  // ===== МАТРИЦА =====
  const canvas = document.getElementById('matrix');
  const ctx = canvas.getContext('2d');

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789ABCDEF';
  const fontSize = 16;
  let columns, drops;

  function initDrops() {
    columns = Math.floor(canvas.width / fontSize);
    drops = Array(columns).fill(1);
  }
  initDrops();
  window.addEventListener('resize', initDrops);

  function drawMatrix() {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#fff';
    ctx.font = fontSize + 'px monospace';

    for (let i = 0; i < drops.length; i++) {
      const char = chars[Math.floor(Math.random() * chars.length)];
      ctx.fillText(char, i * fontSize, drops[i] * fontSize);
      if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    }
  }
  setInterval(drawMatrix, 50);

  // ===== ПЕЧАТАЮЩИЙСЯ ТЕКСТ =====
  const text = 'вайбкодер / дизайнер / игрок в доту';
  const typedEl = document.getElementById('typed');
  let idx = 0;

  function type() {
    if (idx < text.length) {
      typedEl.textContent += text.charAt(idx);
      idx++;
      setTimeout(type, 70);
    } else {
      // цикл: стираем и печатаем заново
      setTimeout(() => {
        typedEl.textContent = '';
        idx = 0;
        type();
      }, 3000);
    }
  }
  setTimeout(type, 800);

  // ===== ПОЯВЛЕНИЕ СЕКЦИЙ =====
  const sections = document.querySelectorAll('section');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.15 });
  sections.forEach(s => observer.observe(s));

  // ===== КУРСОР =====
  const cursor = document.getElementById('cursor');
  document.addEventListener('mousemove', e => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top = e.clientY + 'px';
  });

  document.querySelectorAll('a, .project, .skills li, .btn, .burger, .close, .fact').forEach(el => {
    el.addEventListener('mouseenter', () => cursor.classList.add('big'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('big'));
  });

  // ===== ПРОГРЕСС-БАР =====
  const progress = document.getElementById('progress');
  window.addEventListener('scroll', () => {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = (window.scrollY / h * 100) + '%';
  });

  // ===== МОБИЛЬНОЕ МЕНЮ =====
  const burger = document.getElementById('burger');
  const navMenu = document.getElementById('navMenu');
  burger.addEventListener('click', () => navMenu.classList.toggle('open'));
  navMenu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => navMenu.classList.remove('open'));
  });

  // ===== МОДАЛКИ =====
  const projectsData = {
    p1: {
      title: 'Матричное портфолио',
      text: 'Личный сайт-портфолио в стиле «Матрица». Чёрно-белая палитра, падающие цифры на canvas, кастомный курсор, модальные окна, адаптив под мобильные.',
      text2: 'Стек: HTML, CSS, JavaScript (Canvas API, IntersectionObserver). Сделано вручную, без фреймворков.'
    },
    p2: {
      title: 'Проект #2',
      text: 'Описание появится позже. Здесь будет рассказ о задаче, решении и результате.',
      text2: 'Пока в разработке.'
    },
    p3: {
      title: 'Проект #3',
      text: 'Описание появится позже. Здесь будет рассказ о задаче, решении и результате.',
      text2: 'Пока в разработке.'
    }
  };

  function openModal(id) {
    const data = projectsData[id];
    document.getElementById('modalTitle').textContent = data.title;
    document.getElementById('modalText').textContent = data.text;
    document.getElementById('modalText2').textContent = data.text2;
    document.getElementById('modalBg').classList.add('active');
  }

  function closeModal(e) {
    if (e && e.target !== e.currentTarget && e.type === 'click') return;
    document.getElementById('modalBg').classList.remove('active');
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('modalBg').classList.remove('active');
  });
</script>

</body>
</html>
